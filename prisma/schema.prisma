generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../src/generated/prisma"
  runtime         = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

generator prismaSeed {
  provider = "prisma-client"
  output   = "../src/generated/prisma-seed"
  runtime  = "nodejs"
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ManualPaymentMethod {
  INSTAPAY
  MOBILE_WALLET
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum RetryTaskStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum FulfillmentStatus {
  NOT_STARTED
  CUSTOMER_CREATED
  CARD_CREATED
  ACCESS_CODE_ISSUED
  PRINTING
  DELIVERED
  COMPLETED
}

enum OrderPackage {
  DIGITAL
  DIGITAL_NFC
}

enum CardStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum CardVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum AccessCodeStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum NfcCardStatus {
  AVAILABLE
  RESERVED
  ACTIVATED
  DISABLED
  LOST
  ARCHIVED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationTemplate {
  WELCOME
  ORDER_APPROVED
  CARD_READY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum EditorSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ThemeStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  DRAFT
  TRIAL
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  PAUSED
  CANCELED
  EXPIRED
  ARCHIVED
}

enum SubscriptionReminderType {
  EXPIRY_7_DAYS
  EXPIRY_3_DAYS
  EXPIRY_1_DAY
  EXPIRED
  RENEWED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum PriceCadence {
  FREE
  MONTH
  YEAR
  LIFETIME
}

enum WorkspaceMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum SubscriptionPeriodKind {
  TRIAL
  PAID
  FREE
  COMPLIMENTARY
  LIFETIME
}

enum SubscriptionChangeType {
  UPGRADE
  DOWNGRADE
  CADENCE_CHANGE
  CANCEL
  REACTIVATE
}

enum SubscriptionChangeStatus {
  SCHEDULED
  APPLIED
  CANCELED
  FAILED
}

enum InvoiceLineType {
  BASE
  DISCOUNT
  TAX
  PRORATION
  CREDIT
}

enum PaymentLedgerStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum WebhookInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum EntitlementGrantSource {
  SUBSCRIPTION
  ADMIN
}

enum ProviderObjectType {
  CUSTOMER
  SUBSCRIPTION
  PAYMENT
  PAYMENT_METHOD
  INVOICE
  REFUND
}

enum ProviderMappingInternalType {
  BILLING_ACCOUNT
  SUBSCRIPTION
  PAYMENT
  INVOICE
  REFUND
}

enum AnalyticsEventType {
  VISIT
  QR_SCAN
  CONTACT_SAVE
  BUTTON_CLICK
  SOCIAL_CLICK
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum BotClassification {
  HUMAN
  BOT
  SUSPECTED
  UNKNOWN
}

enum MediaKind {
  AVATAR
  COVER
  LOGO
  IMAGE
  DOCUMENT
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum AuditActorType {
  ADMIN
  EDITOR
  SYSTEM
}

enum LegacyEntityType {
  BUSINESS_CARD
  USER
  SOCIAL_LINK
  ANALYTICS
}

model AdminUser {
  id                   String              @id @default(uuid()) @db.Uuid
  email                String              @unique
  name                 String?
  passwordHash         String?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  roles                AdminUserRole[]
  auditLogs            AuditLog[]          @relation("AdminAuditLogs")
  paymentVerifications PaymentSubmission[] @relation("PaymentVerifications")
  mediaCreated         MediaAsset[]        @relation("AdminMediaCreated")

  @@index([isActive, deletedAt])
}

model AdminRole {
  id        String          @id @default(uuid()) @db.Uuid
  key       String          @unique
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     AdminUserRole[]
}

model AdminUserRole {
  adminUserId String    @db.Uuid
  roleId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
}

model Customer {
  id                 String                 @id @default(uuid()) @db.Uuid
  workspaceId        String                 @db.Uuid
  displayName        String
  email              String?
  phone              String?
  status             CustomerStatus         @default(ACTIVE)
  locale             String                 @default("en")
  timezone           String                 @default("UTC")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  cards              Card[]                 @relation("CustomerCards")
  subscriptions      Subscription[]         @relation("CustomerSubscriptions")
  media              MediaAsset[]           @relation("CustomerMedia")
  settings           Setting[]              @relation("CustomerSettings")
  orders             Order[]                @relation("OrderCustomer")
  notifications      NotificationDelivery[] @relation("CustomerNotifications")
  paymentSubmissions PaymentSubmission[]    @relation("CustomerPayments")
  invoices           Invoice[]              @relation("CustomerInvoices")
  nfcCards           NfcCard[]              @relation("CustomerNfcCards")
  account            CustomerAccount?
  workspaces         Workspace[]            @relation("CustomerWorkspaces")
  billingAccounts    BillingAccount[]       @relation("CustomerBillingAccounts")
  tenantWorkspace    Workspace              @relation("WorkspaceCustomers", fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, email])
  @@index([workspaceId, status, deletedAt])
  @@index([email])
  @@index([phone])
  @@index([status, deletedAt])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_displayName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_phone_trgm_idx")
}

model NfcCard {
  id              String        @id @default(uuid()) @db.Uuid
  activationToken String        @unique @db.VarChar(10)
  status          NfcCardStatus @default(AVAILABLE)
  customerId      String?       @db.Uuid
  workspaceId     String?       @db.Uuid
  cardId          String?       @db.Uuid
  activatedAt     DateTime?
  createdAt       DateTime      @default(now())
  customer        Customer?     @relation("CustomerNfcCards", fields: [customerId], references: [id], onDelete: Restrict)
  workspace       Workspace?    @relation("WorkspaceNfcCards", fields: [workspaceId], references: [id], onDelete: Restrict)
  card            Card?         @relation("CardNfcCards", fields: [cardId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([workspaceId, status])
  @@index([cardId, status])
}

model CustomerAccount {
  id           String                @id @default(uuid()) @db.Uuid
  customerId   String                @unique @db.Uuid
  email        String                @unique
  passwordHash Bytes
  passwordSalt Bytes
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions     CustomerSession[]     @relation("CustomerAccountSessions")
  passwordResets CustomerPasswordReset[] @relation("CustomerAccountPasswordResets")
  memberships  WorkspaceMembership[] @relation("AccountWorkspaceMemberships")
}

model CustomerPasswordReset {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @db.Uuid
  tokenHash Bytes           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  account   CustomerAccount @relation("CustomerAccountPasswordResets", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt, usedAt])
}

model CustomerSession {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @db.Uuid
  tokenHash Bytes           @unique
  expiresAt DateTime
  createdAt DateTime        @default(now())
  revokedAt DateTime?
  account   CustomerAccount @relation("CustomerAccountSessions", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

model Workspace {
  id                    String                 @id @default(uuid()) @db.Uuid
  customerId            String?                @db.Uuid
  primaryCardId         String?                @unique @db.Uuid
  billingAccountId      String?                @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  archivedAt            DateTime?
  customer              Customer?              @relation("CustomerWorkspaces", fields: [customerId], references: [id], onDelete: Restrict)
  primaryCard           Card?                  @relation("WorkspacePrimaryCard", fields: [primaryCardId], references: [id], onDelete: Restrict)
  billingAccount        BillingAccount?        @relation("BillingAccountWorkspaces", fields: [billingAccountId], references: [id], onDelete: SetNull)
  nfcCards              NfcCard[]              @relation("WorkspaceNfcCards")
  memberships           WorkspaceMembership[]  @relation("WorkspaceMemberships")
  subscriptions         Subscription[]         @relation("WorkspaceSubscriptions")
  entitlements          EntitlementGrant[]     @relation("WorkspaceEntitlements")
  ownedCustomers        Customer[]             @relation("WorkspaceCustomers")
  orders                Order[]                @relation("WorkspaceOrders")
  invoices              Invoice[]              @relation("WorkspaceInvoices")
  payments              Payment[]              @relation("WorkspacePayments")
  paymentSubmissions    PaymentSubmission[]    @relation("WorkspacePaymentSubmissions")
  cards                 Card[]                 @relation("WorkspaceCards")
  mediaAssets           MediaAsset[]           @relation("WorkspaceMediaAssets")
  mediaFolders          MediaFolder[]          @relation("WorkspaceMediaFolders")
  notifications         NotificationDelivery[] @relation("WorkspaceNotifications")
  settings              Setting[]              @relation("WorkspaceSettings")
  billingTimeline       BillingTimelineEntry[] @relation("WorkspaceBillingTimeline")
  auditLogs             AuditLog[]             @relation("WorkspaceAuditLogs")
  analyticsEvents       AnalyticsEvent[]       @relation("WorkspaceAnalyticsEvents")
  analyticsAggregates   AnalyticsAggregate[]   @relation("WorkspaceAnalyticsAggregates")
  subscriptionReminders SubscriptionReminder[]

  @@index([customerId, createdAt])
  @@index([billingAccountId])
}

model WorkspaceMembership {
  id          String                    @id @default(uuid()) @db.Uuid
  workspaceId String                    @db.Uuid
  accountId   String                    @db.Uuid
  role        WorkspaceRole
  status      WorkspaceMembershipStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  deletedAt   DateTime?
  workspace   Workspace                 @relation("WorkspaceMemberships", fields: [workspaceId], references: [id], onDelete: Restrict)
  account     CustomerAccount           @relation("AccountWorkspaceMemberships", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, accountId])
  @@index([accountId, status, role, deletedAt])
  @@index([workspaceId, status, role, deletedAt])
}

model BillingAccount {
  id              String                   @id @default(uuid()) @db.Uuid
  customerId      String?                  @db.Uuid
  displayName     String
  billingEmail    String
  countryCode     String?                  @db.VarChar(2)
  taxIdentifier   String?
  defaultCurrency String                   @db.VarChar(3)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  archivedAt      DateTime?
  customer        Customer?                @relation("CustomerBillingAccounts", fields: [customerId], references: [id], onDelete: Restrict)
  workspaces      Workspace[]              @relation("BillingAccountWorkspaces")
  subscriptions   Subscription[]           @relation("BillingAccountSubscriptions")
  invoices        Invoice[]                @relation("BillingAccountInvoices")
  payments        Payment[]                @relation("BillingAccountPayments")
  paymentMethods  PaymentMethodReference[] @relation("BillingAccountPaymentMethods")

  @@index([customerId, archivedAt])
  @@index([billingEmail])
}

model Order {
  id                      String                 @id @default(uuid()) @db.Uuid
  workspaceId             String                 @db.Uuid
  orderNumber             String                 @unique
  customerName            String
  company                 String?
  email                   String
  phone                   String
  package                 OrderPackage
  quantity                Int                    @default(1)
  notes                   String?
  status                  OrderStatus            @default(PENDING)
  paymentStatus           PaymentStatus          @default(PENDING)
  fulfillmentStatus       FulfillmentStatus      @default(NOT_STARTED)
  customerId              String?                @db.Uuid
  planId                  String?                @db.Uuid
  billingInterval         BillingInterval?
  planNameSnapshot        String?
  planDescriptionSnapshot String?
  billingIntervalSnapshot BillingInterval?
  currency                String?                @db.VarChar(3)
  planPriceSnapshot       Int?
  subtotal                Int?
  discount                Int?
  tax                     Int?
  total                   Int?
  accountPasswordHash     Bytes?
  accountPasswordSalt     Bytes?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  customer                Customer?              @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  plan                    Plan?                  @relation("OrderPlan", fields: [planId], references: [id], onDelete: Restrict)
  cards                   Card[]                 @relation("OrderCards")
  notifications           NotificationDelivery[] @relation("OrderNotifications")
  paymentSubmissions      PaymentSubmission[]    @relation("OrderPayments")
  invoices                Invoice[]              @relation("OrderInvoices")
  originatedSubscription  Subscription?          @relation("SubscriptionOriginOrder")
  workspace               Workspace              @relation("WorkspaceOrders", fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([email, createdAt])
  @@index([customerId])
  @@index([planId, createdAt])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_orderNumber_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_customerName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_email_trgm_idx")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_company_trgm_idx")
}

model PaymentSubmission {
  id                  String                  @id @default(uuid()) @db.Uuid
  workspaceId         String                  @db.Uuid
  orderId             String                  @db.Uuid
  customerId          String?                 @db.Uuid
  paymentMethod       ManualPaymentMethod
  amount              Int
  currency            String                  @db.VarChar(3)
  senderName          String
  senderPhone         String
  referenceNumber     String
  paymentProofAssetId String?                 @db.Uuid
  notes               String?
  status              PaymentSubmissionStatus @default(PENDING)
  submittedAt         DateTime                @default(now())
  verifiedAt          DateTime?
  verifiedBy          String?                 @db.Uuid
  rejectionReason     String?
  order               Order                   @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Restrict)
  customer            Customer?               @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: SetNull)
  verifiedAdmin       AdminUser?              @relation("PaymentVerifications", fields: [verifiedBy], references: [id], onDelete: SetNull)
  paymentProofAsset   MediaAsset?             @relation("PaymentProof", fields: [paymentProofAssetId], references: [id], onDelete: SetNull)
  workspace           Workspace               @relation("WorkspacePaymentSubmissions", fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, orderId, referenceNumber])
  @@unique([orderId, referenceNumber])
  @@index([workspaceId, status, submittedAt])
  @@index([status, submittedAt])
  @@index([orderId, status])
}

model Invoice {
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @db.Uuid
  invoiceNumber      String              @unique
  orderId            String              @db.Uuid
  customerId         String              @db.Uuid
  planNameSnapshot   String
  subtotal           Int
  discount           Int                 @default(0)
  tax                Int                 @default(0)
  total              Int
  currency           String              @db.VarChar(3)
  status             InvoiceStatus       @default(ISSUED)
  issuedAt           DateTime            @default(now())
  pdfPath            String?
  generatedBy        String?
  subscriptionId     String?             @db.Uuid
  billingAccountId   String?             @db.Uuid
  periodStart        DateTime?
  periodEnd          DateTime?
  dueAt              DateTime?
  paidAt             DateTime?
  version            Int                 @default(1)
  order              Order               @relation("OrderInvoices", fields: [orderId], references: [id], onDelete: Restrict)
  customer           Customer            @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: Restrict)
  subscription       Subscription?       @relation("SubscriptionInvoices", fields: [subscriptionId], references: [id], onDelete: Restrict)
  billingAccount     BillingAccount?     @relation("BillingAccountInvoices", fields: [billingAccountId], references: [id], onDelete: Restrict)
  lines              InvoiceLine[]       @relation("InvoiceLines")
  paymentAllocations PaymentAllocation[] @relation("InvoicePaymentAllocations")
  workspace          Workspace           @relation("WorkspaceInvoices", fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, issuedAt])
  @@index([workspaceId, status, dueAt])
  @@index([customerId, issuedAt])
  @@index([orderId])
  @@index([subscriptionId, periodStart])
  @@index([billingAccountId, status, dueAt])
  @@index([status, dueAt])
}

model InvoiceLine {
  id              String          @id @default(uuid()) @db.Uuid
  invoiceId       String          @db.Uuid
  type            InvoiceLineType
  description     String
  quantity        Int             @default(1)
  unitAmountMinor BigInt
  amountMinor     BigInt
  currency        String          @db.VarChar(3)
  metadata        Json?
  createdAt       DateTime        @default(now())
  invoice         Invoice         @relation("InvoiceLines", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, type])
}

model RetryTask {
  id         String          @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  operation  String
  status     RetryTaskStatus @default(PENDING)
  retryCount Int             @default(0)
  maxRetries Int             @default(5)
  nextRetry  DateTime?
  lastError  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, nextRetry])
  @@index([entityType, entityId, operation])
}

model BillingTimelineEntry {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  orderId     String    @db.Uuid
  event       String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation("WorkspaceBillingTimeline", fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, orderId, event, entityType, entityId])
  @@unique([orderId, event, entityType, entityId])
  @@index([workspaceId, createdAt])
  @@index([orderId, createdAt])
}

model Card {
  id                String                 @id @default(uuid()) @db.Uuid
  workspaceId       String                 @db.Uuid
  customerId        String                 @db.Uuid
  orderId           String?                @db.Uuid
  themeId           String?                @db.Uuid
  slug              String                 @unique
  name              String
  status            CardStatus             @default(DRAFT)
  visibility        CardVisibility         @default(PRIVATE)
  publishedAt       DateTime?
  accessVersion     Int                    @default(1)
  themeConfig       Json?
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  customer          Customer               @relation("CustomerCards", fields: [customerId], references: [id], onDelete: Restrict)
  order             Order?                 @relation("OrderCards", fields: [orderId], references: [id], onDelete: Restrict)
  theme             Theme?                 @relation("ThemeCards", fields: [themeId], references: [id], onDelete: SetNull)
  profile           CardProfile?
  buttons           CardButton[]           @relation("CardButtons")
  socialLinks       SocialLink[]           @relation("CardSocialLinks")
  sections          CardSection[]          @relation("CardSections")
  blocks            CardBlock[]            @relation("CardBlocks")
  accessCodes       AccessCode[]           @relation("CardAccessCodes")
  editorSessions    EditorSession[]        @relation("CardEditorSessions")
  media             CardMedia[]            @relation("CardMediaLinks")
  events            AnalyticsEvent[]       @relation("CardEvents")
  aggregates        AnalyticsAggregate[]   @relation("CardAggregates")
  legacyIdentifiers LegacyIdentifier[]     @relation("CardLegacyIdentifiers")
  settings          Setting[]              @relation("CardSettings")
  notifications     NotificationDelivery[] @relation("CardNotifications")
  nfcCards          NfcCard[]               @relation("CardNfcCards")
  workspace         Workspace?             @relation("WorkspacePrimaryCard")
  tenantWorkspace   Workspace              @relation("WorkspaceCards", fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, deletedAt])
  @@index([customerId, deletedAt])
  @@index([orderId])
  @@index([status, visibility, deletedAt])
  @@index([themeId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Card_name_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "Card_slug_trgm_idx")
}

model CardProfile {
  cardId      String   @id @db.Uuid
  fullName    String
  headline    String?
  company     String?
  bio         String?
  email       String?
  phone       String?
  website     String?
  address     String?
  countryCode String?  @db.VarChar(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CardSection {
  id        String    @id @default(uuid()) @db.Uuid
  cardId    String    @db.Uuid
  kind      String
  title     String?
  position  Int
  isVisible Boolean   @default(true)
  config    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  card      Card      @relation("CardSections", fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, position])
  @@unique([cardId, kind])
  @@index([cardId, isVisible, position])
}

model CardBlock {
  id        String           @id @default(uuid()) @db.Uuid
  cardId    String           @db.Uuid
  kind      String
  position  Int
  isEnabled Boolean          @default(true)
  config    Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  card      Card             @relation("CardBlocks", fields: [cardId], references: [id], onDelete: Cascade)
  media     CardBlockMedia[] @relation("BlockMedia")

  @@unique([cardId, position])
  @@index([cardId, isEnabled, position])
}

model CardBlockMedia {
  blockId      String     @db.Uuid
  mediaAssetId String     @db.Uuid
  position     Int
  createdAt    DateTime   @default(now())
  block        CardBlock  @relation("BlockMedia", fields: [blockId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation("MediaBlocks", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([blockId, mediaAssetId])
  @@unique([blockId, position])
  @@index([mediaAssetId])
}

model Theme {
  id           String      @id @default(uuid()) @db.Uuid
  key          String      @unique
  name         String
