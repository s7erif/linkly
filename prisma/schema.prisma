  createdAt   DateTime @default(now())
  payment     Payment  @relation("PaymentAllocations", fields: [paymentId], references: [id], onDelete: Restrict)
  invoice     Invoice  @relation("InvoicePaymentAllocations", fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId, createdAt])
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @db.Uuid
  amountMinor BigInt
  currency    String       @db.VarChar(3)
  status      RefundStatus @default(PENDING)
  reason      String?
  providerRef String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payment     Payment      @relation("PaymentRefunds", fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model PaymentMethodReference {
  id               String         @id @default(uuid()) @db.Uuid
  billingAccountId String         @db.Uuid
  provider         String
  providerObjectId String
  type             String?
  last4            String?
  brand            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  billingAccount   BillingAccount @relation("BillingAccountPaymentMethods", fields: [billingAccountId], references: [id], onDelete: Restrict)

  @@unique([provider, providerObjectId])
  @@index([billingAccountId, createdAt])
}

model EntitlementGrant {
  id             String                 @id @default(uuid()) @db.Uuid
  workspaceId    String                 @db.Uuid
  subscriptionId String?                @db.Uuid
  key            String
  limitValue     Int?
  source         EntitlementGrantSource @default(SUBSCRIPTION)
  startsAt       DateTime
  endsAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  workspace      Workspace              @relation("WorkspaceEntitlements", fields: [workspaceId], references: [id], onDelete: Restrict)
  subscription   Subscription?          @relation("SubscriptionEntitlements", fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([workspaceId, key, startsAt, endsAt])
  @@index([subscriptionId, key])
}

model ProviderObjectReference {
  id                 String                      @id @default(uuid()) @db.Uuid
  provider           String
  providerObjectType ProviderObjectType
  externalId         String
  internalType       ProviderMappingInternalType
  internalId         String                      @db.Uuid
  paymentId          String?                     @db.Uuid
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  payment            Payment?                    @relation("PaymentProviderRefs", fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerObjectType, externalId])
  @@unique([provider, internalType, internalId, providerObjectType])
  @@index([internalType, internalId])
}

model WebhookInbox {
  id              String             @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  eventType       String
  payload         Json?
  status          WebhookInboxStatus @default(RECEIVED)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  errorMessage    String?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  idempotencyKey String            @unique
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  availableAt    DateTime          @default(now())
  occurredAt     DateTime          @default(now())
  publishedAt    DateTime?
  attempts       Int               @default(0)
  lastError      String?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, occurredAt])
}
