generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../src/generated/prisma"
  runtime         = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}
enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ManualPaymentMethod {
  INSTAPAY
  MOBILE_WALLET
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}
enum RetryTaskStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum FulfillmentStatus {
  NOT_STARTED
  CUSTOMER_CREATED
  CARD_CREATED
  ACCESS_CODE_ISSUED
  PRINTING
  DELIVERED
  COMPLETED
}

enum OrderPackage {
  DIGITAL
  DIGITAL_NFC
}

enum CardStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum CardVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum AccessCodeStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationTemplate {
  WELCOME
  ORDER_APPROVED
  CARD_READY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum EditorSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ThemeStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AnalyticsEventType {
  VISIT
  QR_SCAN
  CONTACT_SAVE
  BUTTON_CLICK
  SOCIAL_CLICK
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum BotClassification {
  HUMAN
  BOT
  SUSPECTED
  UNKNOWN
}

enum MediaKind {
  AVATAR
  COVER
  LOGO
  IMAGE
  DOCUMENT
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum AuditActorType {
  ADMIN
  EDITOR
  SYSTEM
}

enum LegacyEntityType {
  BUSINESS_CARD
  USER
  SOCIAL_LINK
  ANALYTICS
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  name         String?
  passwordHash String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  roles        AdminUserRole[]
  auditLogs    AuditLog[]      @relation("AdminAuditLogs")
  paymentVerifications PaymentSubmission[] @relation("PaymentVerifications")
  mediaCreated MediaAsset[]   @relation("AdminMediaCreated")

  @@index([isActive, deletedAt])
}

model AdminRole {
  id        String          @id @default(uuid()) @db.Uuid
  key       String          @unique
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     AdminUserRole[]
}

model AdminUserRole {
  adminUserId String    @db.Uuid
  roleId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
}

model Customer {
  id            String                 @id @default(uuid()) @db.Uuid
  displayName   String
  email         String?
  phone         String?
  status        CustomerStatus         @default(ACTIVE)
  locale        String                 @default("en")
  timezone      String                 @default("UTC")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?
  cards         Card[]                 @relation("CustomerCards")
  subscriptions Subscription[]         @relation("CustomerSubscriptions")
  media         MediaAsset[]           @relation("CustomerMedia")
  settings      Setting[]              @relation("CustomerSettings")
  orders        Order[]                @relation("OrderCustomer")
  notifications NotificationDelivery[] @relation("CustomerNotifications")
  paymentSubmissions PaymentSubmission[] @relation("CustomerPayments")
  invoices Invoice[] @relation("CustomerInvoices")

  @@index([email])
  @@index([phone])
  @@index([status, deletedAt])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_displayName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_phone_trgm_idx")
}

model Order {
  id                String                 @id @default(uuid()) @db.Uuid
  orderNumber       String                 @unique
  customerName      String
  company           String?
  email             String
  phone             String
  package           OrderPackage
  quantity          Int                    @default(1)
  notes             String?
  status            OrderStatus            @default(PENDING)
  paymentStatus     PaymentStatus          @default(PENDING)
  fulfillmentStatus FulfillmentStatus      @default(NOT_STARTED)
  customerId        String?                @db.Uuid
  planId            String?                @db.Uuid
  billingInterval   BillingInterval?
  planNameSnapshot  String?
  planDescriptionSnapshot String?
  billingIntervalSnapshot BillingInterval?
  currency          String?                @db.VarChar(3)
  planPriceSnapshot Int?
  subtotal          Int?
  discount          Int?
  tax               Int?
  total             Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  customer          Customer?              @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  plan              Plan?                  @relation("OrderPlan", fields: [planId], references: [id], onDelete: Restrict)
  cards             Card[]                 @relation("OrderCards")
  notifications     NotificationDelivery[] @relation("OrderNotifications")
  paymentSubmissions PaymentSubmission[] @relation("OrderPayments")
  invoices          Invoice[]             @relation("OrderInvoices")

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([email, createdAt])
  @@index([customerId])
  @@index([planId, createdAt])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_orderNumber_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_customerName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_email_trgm_idx")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_company_trgm_idx")
}

model PaymentSubmission {
  id                 String                  @id @default(uuid()) @db.Uuid
  orderId            String                  @db.Uuid
  customerId         String?                 @db.Uuid
  paymentMethod      ManualPaymentMethod
  amount             Int
  currency           String                  @db.VarChar(3)
  senderName         String
  senderPhone        String
  referenceNumber    String
  paymentProofAssetId String?                @db.Uuid
  notes              String?
  status             PaymentSubmissionStatus @default(PENDING)
  submittedAt        DateTime                @default(now())
  verifiedAt         DateTime?
  verifiedBy         String?                 @db.Uuid
  rejectionReason    String?
  order              Order                   @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Restrict)
  customer           Customer?               @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: SetNull)
  verifiedAdmin      AdminUser?              @relation("PaymentVerifications", fields: [verifiedBy], references: [id], onDelete: SetNull)
  paymentProofAsset  MediaAsset?             @relation("PaymentProof", fields: [paymentProofAssetId], references: [id], onDelete: SetNull)
  @@index([status, submittedAt])
  @@index([orderId, status])
  @@unique([orderId, referenceNumber])
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceNumber      String        @unique
  orderId            String        @db.Uuid
  customerId         String        @db.Uuid
  planNameSnapshot   String
  subtotal           Int
  discount           Int           @default(0)
  tax                Int           @default(0)
  total              Int
  currency           String        @db.VarChar(3)
  status             InvoiceStatus @default(ISSUED)
  issuedAt           DateTime      @default(now())
  pdfPath            String?
  generatedBy        String?
  order              Order         @relation("OrderInvoices", fields: [orderId], references: [id], onDelete: Restrict)
  customer           Customer      @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: Restrict)
  @@index([customerId, issuedAt])
  @@index([orderId])
}

model RetryTask {
  id String @id @default(uuid()) @db.Uuid
  entityType String
  entityId String
  operation String
  status RetryTaskStatus @default(PENDING)
  retryCount Int @default(0)
  maxRetries Int @default(5)
  nextRetry DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextRetry])
  @@index([entityType, entityId, operation])
}
model BillingTimelineEntry {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  event String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
  @@unique([orderId, event, entityType, entityId])
}

model Card {
  id                String                 @id @default(uuid()) @db.Uuid
  customerId        String                 @db.Uuid
  orderId           String?                @db.Uuid
  themeId           String?                @db.Uuid
  slug              String                 @unique
  name              String
  status            CardStatus             @default(DRAFT)
  visibility        CardVisibility         @default(PRIVATE)
  publishedAt       DateTime?
  accessVersion     Int                    @default(1)
  themeConfig       Json?
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  customer          Customer               @relation("CustomerCards", fields: [customerId], references: [id], onDelete: Restrict)
  order             Order?                 @relation("OrderCards", fields: [orderId], references: [id], onDelete: Restrict)
  theme             Theme?                 @relation("ThemeCards", fields: [themeId], references: [id], onDelete: SetNull)
  profile           CardProfile?
  buttons           CardButton[]           @relation("CardButtons")
  socialLinks       SocialLink[]           @relation("CardSocialLinks")
  sections          CardSection[]          @relation("CardSections")
  blocks            CardBlock[]            @relation("CardBlocks")
  accessCodes       AccessCode[]           @relation("CardAccessCodes")
  editorSessions    EditorSession[]        @relation("CardEditorSessions")
  media             CardMedia[]            @relation("CardMediaLinks")
  events            AnalyticsEvent[]       @relation("CardEvents")
  aggregates        AnalyticsAggregate[]   @relation("CardAggregates")
  legacyIdentifiers LegacyIdentifier[]     @relation("CardLegacyIdentifiers")
  settings          Setting[]              @relation("CardSettings")
  notifications     NotificationDelivery[] @relation("CardNotifications")

  @@index([customerId, deletedAt])
  @@index([orderId])
  @@index([status, visibility, deletedAt])
  @@index([themeId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Card_name_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "Card_slug_trgm_idx")
}

model CardProfile {
  cardId      String   @id @db.Uuid
  fullName    String
  headline    String?
  company     String?
  bio         String?
  email       String?
  phone       String?
  website     String?
  address     String?
  countryCode String?  @db.VarChar(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CardSection {
  id        String    @id @default(uuid()) @db.Uuid
  cardId    String    @db.Uuid
  kind      String
  title     String?
  position  Int
  isVisible Boolean   @default(true)
  config    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  card      Card      @relation("CardSections", fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, position])
  @@unique([cardId, kind])
  @@index([cardId, isVisible, position])
}

model CardBlock {
  id        String           @id @default(uuid()) @db.Uuid
  cardId    String           @db.Uuid
  kind      String
  position  Int
  isEnabled Boolean          @default(true)
  config    Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  card      Card             @relation("CardBlocks", fields: [cardId], references: [id], onDelete: Cascade)
  media     CardBlockMedia[] @relation("BlockMedia")

  @@unique([cardId, position])
  @@index([cardId, isEnabled, position])
}

model CardBlockMedia {
  blockId      String     @db.Uuid
  mediaAssetId String     @db.Uuid
  position     Int
  createdAt    DateTime   @default(now())
  block        CardBlock  @relation("BlockMedia", fields: [blockId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation("MediaBlocks", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([blockId, mediaAssetId])
  @@unique([blockId, position])
  @@index([mediaAssetId])
}

model Theme {
  id           String      @id @default(uuid()) @db.Uuid
  key          String      @unique
  name         String
  version      Int         @default(1)
  status       ThemeStatus @default(DRAFT)
  configSchema Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  cards        Card[]      @relation("ThemeCards")

  @@index([status])
}

model SocialLink {
  id        String           @id @default(uuid()) @db.Uuid
  cardId    String           @db.Uuid
  platform  String
  label     String?
  url       String
  position  Int
  isVisible Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  card      Card             @relation("CardSocialLinks", fields: [cardId], references: [id], onDelete: Cascade)
  events    AnalyticsEvent[] @relation("SocialEvents")

  @@unique([cardId, position])
  @@index([cardId, isVisible, position])
  @@map("CardSocialLink")
}

model CardButton {
  id        String           @id @default(uuid()) @db.Uuid
  cardId    String           @db.Uuid
  label     String
  url       String
  position  Int
  isVisible Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  card      Card             @relation("CardButtons", fields: [cardId], references: [id], onDelete: Cascade)
  events    AnalyticsEvent[] @relation("ButtonEvents")

  @@unique([cardId, position])
  @@index([cardId, isVisible, position])
  @@map("CardButton")
}

model AccessCode {
  id            String            @id @default(uuid()) @db.Uuid
  cardId        String            @db.Uuid
  codeHash      Bytes             @unique
  version       Int
  status        AccessCodeStatus  @default(ACTIVE)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  useCount      Int               @default(0)
  rotatedFromId String?           @unique @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  revokedAt     DateTime?
  card          Card              @relation("CardAccessCodes", fields: [cardId], references: [id], onDelete: Cascade)
  rotatedFrom   AccessCode?       @relation("CodeRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo     AccessCode?       @relation("CodeRotation")
  sessions      EditorSession[]   @relation("CodeSessions")
  usage         AccessCodeUsage[] @relation("CodeUsage")

  @@unique([cardId, version])
  @@unique([cardId], map: "AccessCode_one_active_per_card", where: { status: "ACTIVE" })
  @@index([cardId, status])
  @@index([expiresAt])
}

model AccessCodeUsage {
  id            String     @id @default(uuid()) @db.Uuid
  accessCodeId  String     @db.Uuid
  occurredAt    DateTime   @default(now())
  success       Boolean
  ipHash        Bytes?
  userAgentHash Bytes?
  failureReason String?
  accessCode    AccessCode @relation("CodeUsage", fields: [accessCodeId], references: [id], onDelete: Cascade)

  @@index([accessCodeId, occurredAt])
}

model EditorSession {
  id           String              @id @default(uuid()) @db.Uuid
  cardId       String              @db.Uuid
  accessCodeId String              @db.Uuid
  tokenHash    Bytes               @unique
  status       EditorSessionStatus @default(ACTIVE)
  expiresAt    DateTime
  lastSeenAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  revokedAt    DateTime?
  card         Card                @relation("CardEditorSessions", fields: [cardId], references: [id], onDelete: Cascade)
  accessCode   AccessCode          @relation("CodeSessions", fields: [accessCodeId], references: [id], onDelete: Cascade)

  @@index([cardId, status])
  @@index([expiresAt])
}

model Plan {
  id             String         @id @default(uuid()) @db.Uuid
  key            String         @unique
  name           String
  description    String?
  priceMinor     Int
  currency       String         @db.VarChar(3)
  intervalMonths Int
  monthlyMinor   Int?
  quarterlyMinor Int?
  yearlyMinor    Int?
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[] @relation("PlanSubscriptions")
  features       PlanFeature[]  @relation("PlanFeatures")
  orders         Order[]        @relation("OrderPlan")

  @@index([isActive, sortOrder])
}

model PlanFeature {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @db.Uuid
  key        String
  enabled    Boolean  @default(true)
  limitValue Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  plan       Plan     @relation("PlanFeatures", fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key, enabled])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  customerId         String             @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus
  billingInterval    BillingInterval     @default(MONTHLY)
  provider           String
  providerRef        String?            @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  suspendedAt        DateTime?
  renewedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customer           Customer           @relation("CustomerSubscriptions", fields: [customerId], references: [id], onDelete: Restrict)
  plan               Plan               @relation("PlanSubscriptions", fields: [planId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@index([planId, status])
  @@index([status, currentPeriodEnd])
}

model MediaAsset {
  id               String           @id @default(uuid()) @db.Uuid
  customerId       String?          @db.Uuid
  createdByAdminId String?          @db.Uuid
  folderId         String?          @db.Uuid
  kind             MediaKind
  status           MediaStatus      @default(PENDING)
  storageKey       String           @unique
  publicUrl        String?
  fileName         String
  originalFilename String?
  extension        String?
  contentType      String
  byteSize         BigInt
  checksum         String?
  width            Int?
  height           Int?
  altText          String?
  caption          String?
  tags             String[]         @default([])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  customer         Customer?        @relation("CustomerMedia", fields: [customerId], references: [id], onDelete: Restrict)
  createdByAdmin   AdminUser?       @relation("AdminMediaCreated", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  folder           MediaFolder?     @relation("FolderAssets", fields: [folderId], references: [id], onDelete: SetNull)
  cards            CardMedia[]      @relation("MediaCardLinks")
  cardBlockMedias  CardBlockMedia[] @relation("MediaBlocks")
  usages           MediaUsage[]     @relation("AssetUsages")
  paymentProofs    PaymentSubmission[] @relation("PaymentProof")

  @@index([customerId, status, deletedAt])
  @@index([folderId, status, deletedAt])
  @@index([status, createdAt])
  @@index([contentType, createdAt])
}

model MediaFolder {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?      @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parent    MediaFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  assets    MediaAsset[] @relation("FolderAssets")
  @@unique([parentId, name])
  @@index([parentId])
}

model MediaUsage {
  id         String     @id @default(uuid()) @db.Uuid
  mediaAssetId String   @db.Uuid
  entityType String
  entityId   String
  field      String
  createdAt  DateTime   @default(now())
  mediaAsset MediaAsset @relation("AssetUsages", fields: [mediaAssetId], references: [id], onDelete: Cascade)
  @@unique([mediaAssetId, entityType, entityId, field])
  @@index([entityType, entityId])
}

model CardMedia {
  cardId       String     @db.Uuid
  mediaAssetId String     @db.Uuid
  role         MediaKind
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  card         Card       @relation("CardMediaLinks", fields: [cardId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation("MediaCardLinks", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([cardId, mediaAssetId, role])
  @@index([cardId, role, position])
}

model AnalyticsEvent {
  id           String             @id @default(uuid()) @db.Uuid
  cardId       String             @db.Uuid
  type         AnalyticsEventType
  occurredAt   DateTime           @default(now())
  receivedAt   DateTime           @default(now())
  sessionHash  Bytes?
  visitorHash  Bytes?
  countryCode  String?            @db.VarChar(2)
  browser      String?
  os           String?
  deviceType   DeviceType         @default(UNKNOWN)
  botClass     BotClassification  @default(UNKNOWN)
  buttonId     String?            @db.Uuid
  socialLinkId String?            @db.Uuid
  referrerHost String?
  metadata     Json?
  card         Card               @relation("CardEvents", fields: [cardId], references: [id], onDelete: Cascade)
  button       CardButton?        @relation("ButtonEvents", fields: [buttonId], references: [id], onDelete: SetNull)
  socialLink   SocialLink?        @relation("SocialEvents", fields: [socialLinkId], references: [id], onDelete: SetNull)

  @@index([cardId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([cardId, countryCode, occurredAt])
}

model AnalyticsAggregate {
  id             String             @id @default(uuid()) @db.Uuid
  cardId         String             @db.Uuid
  period         String
  bucketStart    DateTime
  eventType      AnalyticsEventType
  dimension      String
  dimensionValue String
  count          BigInt             @default(0)
  uniqueCount    BigInt?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  card           Card               @relation("CardAggregates", fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, period, bucketStart, eventType, dimension, dimensionValue])
  @@index([cardId, period, bucketStart])
}

model NotificationDelivery {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @db.Uuid
  customerId        String               @db.Uuid
  cardId            String               @db.Uuid
  channel           NotificationChannel
  template          NotificationTemplate
  recipient         String
  status            NotificationStatus   @default(PENDING)
  provider          String
  providerMessageId String?
  idempotencyKey    String               @unique
  attemptCount      Int                  @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation("OrderNotifications", fields: [orderId], references: [id], onDelete: Restrict)
  customer          Customer             @relation("CustomerNotifications", fields: [customerId], references: [id], onDelete: Restrict)
  card              Card                 @relation("CardNotifications", fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([cardId, channel, template])
  @@index([orderId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, lastAttemptAt])
}

model Setting {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @db.Uuid
  cardId     String?   @db.Uuid
  scope      String
  key        String
  value      Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation("CustomerSettings", fields: [customerId], references: [id], onDelete: Cascade)
  card       Card?     @relation("CardSettings", fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([scope, customerId, cardId, key])
  @@index([customerId, key])
  @@index([cardId, key])
}

model AuditLog {
  id              String         @id @default(uuid()) @db.Uuid
  actorType       AuditActorType
  adminUserId     String?        @db.Uuid
  editorSessionId String?        @db.Uuid
  action          String
  resourceType    String
  resourceId      String?
  success         Boolean        @default(true)
  ipHash          Bytes?
  metadata        Json?
  createdAt       DateTime       @default(now())
  adminUser       AdminUser?     @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorType, createdAt])
}

model LegacyIdentifier {
  id           String           @id @default(uuid()) @db.Uuid
  entityType   LegacyEntityType
  legacySystem String
  legacyId     String
  legacyHash   String?
  cardId       String?          @db.Uuid
  createdAt    DateTime         @default(now())
  card         Card?            @relation("CardLegacyIdentifiers", fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([legacySystem, entityType, legacyId])
  @@unique([legacySystem, legacyHash])
  @@index([legacyHash])
  @@index([cardId])
}

// Prototype compatibility tables remain mapped until migration is verified.
model LegacyUser {
  id            String               @id @default(cuid())
  name          String?
  email         String?              @unique
  emailVerified DateTime?
  image         String?
  accounts      LegacyAccount[]
  sessions      LegacySession[]
  cards         LegacyBusinessCard[]

  @@map("User")
}

model LegacyAccount {
  id                String     @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              LegacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Account")
}

model LegacySession {
  id           String     @id @default(cuid())
  sessionToken String     @unique
  userId       String
  expires      DateTime
  user         LegacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

model LegacyVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationToken")
}

model LegacyBusinessCard {
  id              String             @id @default(cuid())
  name            String
  title           String
  company         String
  address         String?
  phone           String?
  email           String?
  website         String?
  bio             String?
  avatar          String?
  backgroundImage String?
  socialLinksJson String             @map("socialLinks")
  templateId      String             @default("classic")
  urlHash         String             @unique @default(cuid())
  slug            String             @unique
  isActive        Boolean            @default(true)
  createTime      DateTime           @default(now())
  updateTime      DateTime
  userId          String
  user            LegacyUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialLinks     LegacySocialLink[]
  analytics       LegacyAnalytics?

  @@map("BusinessCard")
}

model LegacySocialLink {
  id             String             @id @default(cuid())
  businessCardId String
  platform       String
  url            String
  order          Int                @default(0)
  createdAt      DateTime           @default(now())
  businessCard   LegacyBusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([businessCardId])
  @@map("SocialLink")
}

model LegacyAnalytics {
  id             String             @id @default(cuid())
  businessCardId String             @unique
  pageViews      Int                @default(0)
  qrScans        Int                @default(0)
  linkClicks     Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime
  businessCard   LegacyBusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@map("Analytics")
}
