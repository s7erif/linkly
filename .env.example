# Database Connection (PostgreSQL)
# DATABASE_URL is for connection pooling, DIRECT_URL is for direct database migrations
DATABASE_URL="postgresql://postgres:password@localhost:5432/digital_business_card?sslmode=disable"
DIRECT_URL="postgresql://postgres:password@localhost:5432/digital_business_card?sslmode=disable"

# Required 32+ byte HMAC key for access-code hashing. Generate with: openssl rand -hex 32
# Keep this stable for the lifetime of stored access-code hashes; never commit a real value.
ACCESS_CODE_HMAC_KEY="replace-with-64-character-random-hex-value"

# Structured application logging threshold
LOG_LEVEL="info"

# Canonical public origin used to construct links in transactional emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email (Resend). Use a verified sender in production.
# Approval remains successful when delivery is not configured or fails; the failure is recorded for operators.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="OI Cards <onboarding@resend.dev>"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_random_secret_with_openssl_rand_base64_32"

# Google OAuth Credentials (for Sign-in)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret"

# App Theme Configuration (light or dark)
NEXT_PUBLIC_THEME="light"

# 32+ character bearer secret for the daily subscription expiration job
SUBSCRIPTION_CRON_SECRET=
