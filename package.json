{
  "name": "digital-business-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "architecture:check": "node scripts/check-architecture.mjs",
    "verify:foundation": "npm run architecture:check && npm run typecheck && npm run lint && npm run build",
    "test": "vitest run",
    "verify:sprint2": "npm run architecture:check && npm run typecheck && npm run test && npm run lint && npm run build",
    "verify:sprint3": "npm run architecture:check && npm run typecheck && npm run test && npm run lint && npm run build",
"cf:build": "opennextjs-cloudflare build",
"cf:preview": "opennextjs-cloudflare preview",
"cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.26.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.14",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
